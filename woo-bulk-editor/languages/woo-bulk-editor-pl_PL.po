#: data/fields.php:270
#: ext/filters/views/panel.php:354
msgid "Downloadable"
msgstr "Do pobrania"

#: data/fields.php:271
msgid "Downloadable products give access to a file upon purchase."
msgstr "Produkty do pobrania dają dostęp do pliku po zakupie."

#: data/fields.php:289
msgid "Down.Files"
msgstr "Pliki do pobr."

#: data/fields.php:290
msgid "Downloadable files. Attention: maybe should be enabled Downloadable by logic!"
msgstr "Pliki do pobrania. Uwaga: być może trzeba włączyć opcję Do pobrania!"

#: data/fields.php:303
msgid "Download limit"
msgstr "Limit pobrań"

#: data/fields.php:304
msgid "Leave blank for unlimited re-downloads.  Attention: maybe should be enabled Downloadable by logic!"
msgstr "Pozostaw puste dla nielimitowanej liczby pobrań.  Uwaga: być może trzeba włączyć opcję Do pobrania!"

#: data/fields.php:317
msgid "Download expiry"
msgstr "Wygaśnięcie pobierania"

#: data/fields.php:318
msgid "Enter the number of days before a download link expires, or leave blank. Attention: maybe should be enabled Downloadable by logic!"
msgstr "Wpisz liczbę dni przed wygaśnięciem linku do pobrania lub pozostaw puste. Uwaga: być może trzeba włączyć opcję Do pobrania!"

#: data/fields.php:331
msgid "Tax status"
msgstr "Status podatku"

#: data/fields.php:332
msgid "Define whether or not the entire product is taxable, or just the cost of shipping it."
msgstr "Ustaw czy sprzedaż produktu będzie opodatkowana, czy tylko koszty jego wysyłki."

#: data/fields.php:338
msgid "Taxable"
msgstr "Opodatkowany"

#: data/fields.php:339
msgid "Shipping only"
msgstr "Tylko wysyłka"

#: data/fields.php:340
msgid "None"
msgstr "Brak"

#: data/fields.php:350
#: ext/filters/views/panel.php:537
msgid "Tax class"
msgstr "Klasa podatkowa"

#: data/fields.php:351
msgid "Choose a tax class for this product. Tax classes are used to apply different tax rates specific to certain types of product."
msgstr "Wybierz klasę podatkową dla tego produktu. Klasy podatkowe umożliwiają przypisywanie różnych stawek podatkowych do różnych typów produktów."

#: data/fields.php:356
msgid "Same as parent"
msgstr "Taka sama jak nadrzędny"

#: data/fields.php:365
#: ext/bulk/bulk.php:960
#: ext/bulk/views/panel.php:273
#: ext/bulk/views/panel.php:318
#: ext/filters/filters.php:1574
msgid "SKU"
msgstr "SKU"

#: data/fields.php:366
msgid "SKU refers to a Stock-keeping unit, a unique identifier for each distinct product and service that can be purchased."
msgstr "SKU oznacza jednostkę magazynową, unikatowy identyfikator każdego odrębnego produktu lub usługi, które można kupić."

#: data/fields.php:378
msgid "Manage stock"
msgstr "Zarządzanie magazynem"

#: data/fields.php:379
msgid "Enable stock management at product level. ATTENTION: if to set count of products in Stock quantity, Manage stock option automatically set as TRUE!"
msgstr "Włącz zarządzanie magazynem na poziomie produktu. UWAGA: jeśli ustawisz liczbę produktów w polu Ilość w magazynie, opcja Zarządzanie magazynem zostanie automatycznie ustawiona na TAK!"

#: data/fields.php:397
msgid "Stock quantity"
msgstr "Ilość w magazynie"

#: data/fields.php:398
msgid "Stock quantity. If this is a variable product this value will be used to control stock for all variations, unless you define stock at variation level. ATTENTION: if to set count of products, Manage stock and Stock status options automatically set as TRUE!"
msgstr "Ilość w magazynie. Jeśli jest to produkt zmienny, ta wartość będzie używana do kontroli stanu magazynowego wszystkich wariacji, chyba że zdefiniujesz stan magazynowy na poziomie wariacji. UWAGA: jeśli ustawisz liczbę produktów, opcje Zarządzanie magazynem i Stan magazynowy zostaną automatycznie ustawione na TAK!"

#: data/fields.php:412
#: ext/filters/views/panel.php:311
msgid "Stock status"
msgstr "Stan magazynowy"

#: data/fields.php:413
msgid "Controls whether or not the product is listed as in stock or out of stock on the frontend. Count products in stock can not be zero while activating!"
msgstr "Określa, czy produkt jest wyświetlany jako dostępny, czy niedostępny na stronie sklepu. Liczba produktów w magazynie nie może wynosić zero podczas aktywacji!"

#: data/fields.php:427
msgid "Allow backorders"
msgstr "Zezwól na zamówienia oczekujące"

#: data/fields.php:428
msgid "If managing stock, this controls whether or not backorders are allowed. If enabled, stock quantity can go below 0. Does Not work if the product Manage stock option is not activated!"
msgstr "Jeśli zarządzasz magazynem, ta opcja określa, czy zamówienia oczekujące są dozwolone. Jeśli włączone, ilość w magazynie może spaść poniżej 0. Nie działa, jeśli opcja Zarządzanie magazynem nie jest włączona!"

#: data/fields.php:442
#: ext/filters/views/panel.php:374
msgid "Sold individually"
msgstr "Sprzedawany pojedynczo"

#: data/fields.php:443
msgid "Enable this to only allow one of this item to be bought in a single order"
msgstr "Włącz, aby umożliwić zakup tylko jednej sztuki tego produktu w jednym zamówieniu"

#: data/fields.php:461
msgid "Weight"
msgstr "Waga"

#: data/fields.php:476
msgid "Length"
msgstr "Długość"

#: data/fields.php:491
msgid "Width"
msgstr "Szerokość"

#: data/fields.php:506
msgid "Height"
msgstr "Wysokość"

#: data/fields.php:521
msgid "Shipping class"
msgstr "Klasa wysyłkowa"

#: data/fields.php:522
msgid "Shipping classes are used by certain shipping methods to group similar products."
msgstr "Klasy wysyłkowe są używane przez niektóre sposoby wysyłki, aby grupować podobne produkty."

#: data/fields.php:537
msgid "Upsells"
msgstr "Sprzedaż dodatkowa"

#: data/fields.php:538
msgid "Upsells are products which you recommend instead of the currently viewed product, for example, products that are more profitable or better quality or more expensive."
msgstr "Sprzedaż dodatkowa to produkty, które polecasz zamiast aktualnie przeglądanego produktu, na przykład produkty bardziej rentowne, lepszej jakości lub droższe."

#: data/fields.php:551
msgid "Cross-sells"
msgstr "Sprzedaż krzyżowa"

#: data/fields.php:552
msgid "Cross-sells are products which you promote in the cart, based on the current product."
msgstr "Sprzedaż krzyżowa polega na promowaniu produktów w koszyku na podstawie bieżącego produktu."

#: data/fields.php:565
msgid "Grouped products"
msgstr "Produkty grupowe"

#: data/fields.php:566
msgid "This lets you choose which products are part of this group."
msgstr "Możesz wybrać, które produkty będą częścią tej grupy."

#: data/fields.php:579
msgid "Purchase note"
msgstr "Notatka do zakupu"

#: data/fields.php:580
msgid "Enter an optional note to send the customer after purchase."
msgstr "Wpisz opcjonalną notatkę wysyłaną do klienta po zakupie."

#: data/fields.php:593
msgid "Menu order"
msgstr "Kolejność w menu"

#: data/fields.php:594
msgid "Custom ordering position."
msgstr "Niestandardowa kolejność."

#: data/fields.php:608
msgid "Reviews allowed"
msgstr "Recenzje dozwolone"

#: data/fields.php:625
msgid "Product url"
msgstr "Adres URL produktu"

#: data/fields.php:626
msgid "External/Affiliate product: External URL to the product"
msgstr "Produkt zewnętrzny/partnerski: zewnętrzny URL do produktu"

#: data/fields.php:640
msgid "Aff.Button text"
msgstr "Tekst przycisku part."

#: data/fields.php:641
msgid "External/Affiliate product: This text will be shown on the button linking to the external product"
msgstr "Produkt zewnętrzny/partnerski: ten tekst będzie wyświetlany na przycisku prowadzącym do produktu zewnętrznego"

#: data/fields.php:654
msgid "Virtual"
msgstr "Wirtualny"

#: data/fields.php:655
msgid "Virtual products are intangible and are not shipped."
msgstr "Produkty wirtualne są niematerialne i nie są wysyłane."

#: data/fields.php:672
msgid "Author"
msgstr "Autor"

#: data/fields.php:686
msgid "Attribute visibility"
msgstr "Widoczność atrybutu"

#: data/fields.php:699
msgid "Total sales"
msgstr "Łączna sprzedaż"

#: data/fields.php:700
msgid "Total count of the product sales"
msgstr "Łączna liczba sprzedaży produktu"

#: data/fields.php:715
msgid "Review count"
msgstr "Liczba recenzji"

#: data/fields.php:716
msgid "How many times the products been reviewed by customers"
msgstr "Ile razy produkt został zrecenzowany przez klientów"

#: data/fields.php:731
msgid "Average rating"
msgstr "Średnia ocena"

#: data/fields.php:732
msgid "Average rating of the product"
msgstr "Średnia ocena produktu"

#: data/fields.php:761
msgid "Date Published"
msgstr "Data publikacji"

#: data/fields.php:775
msgid "Parent"
msgstr "Nadrzędny"

