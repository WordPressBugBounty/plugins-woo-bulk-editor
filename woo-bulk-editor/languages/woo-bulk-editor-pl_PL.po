#: data/settings.php:14
#, php-format
msgid "How many rows of products show per page in tab Products. Max possible value is 100! To set more - read %s please"
msgstr "Ile wierszy produktów wyświetlać na stronie w karcie Produkty. Maksymalna możliwa wartość to 100! Aby ustawić więcej - przeczytaj %s"

#: data/settings.php:18
msgid "this article"
msgstr "ten artykuł"

#: data/settings.php:27
msgid "Default sort by"
msgstr "Domyślne sortowanie według"

#: data/settings.php:28
msgid "Select column by which products sorting is going after plugin page loaded"
msgstr "Wybierz kolumnę, według której sortowane są produkty po załadowaniu strony wtyczki"

#: data/settings.php:34
msgid "Default sort"
msgstr "Domyślny kierunek sortowania"

#: data/settings.php:35
msgid "Select sort direction for Default sort by column above"
msgstr "Wybierz kierunek sortowania dla kolumny wybranej powyżej w Domyślnym sortowaniu"

#: data/settings.php:44
msgid "Show button in admin bar"
msgstr "Pokaż przycisk na pasku administracyjnym"

#: data/settings.php:45
msgid "Show Bulk Editor button in admin bar for quick access to the products editor"
msgstr "Pokaż przycisk Bulk Editor na pasku administracyjnym dla szybkiego dostępu do edytora produktów"

#: data/settings.php:54
msgid "Show thumbnail preview"
msgstr "Pokaż podgląd miniatury"

#: data/settings.php:55
msgid "Show bigger thumbnail preview on mouse over"
msgstr "Pokaż większy podgląd miniatury po najechaniu myszą"

#: data/settings.php:64
msgid "Load beauty switchers"
msgstr "Ładuj estetyczne przełączniki"

#: data/settings.php:65
msgid "Load beauty switchers instead of checkboxes in the products table."
msgstr "Ładuj estetyczne przełączniki zamiast pól wyboru w tabeli produktów."

#: data/settings.php:74
msgid "Number of posts processed at a time"
msgstr "Liczba wpisów przetwarzanych na raz"

#: data/settings.php:75
msgid "This option is beneficial if your server has limited memory; by decreasing the speed of the operation, you can enhance stability. The more powerful your server, the higher value you can set here"
msgstr "Ta opcja jest przydatna, jeśli twój serwer ma ograniczoną pamięć; zmniejszając szybkość operacji, możesz zwiększyć stabilność. Im mocniejszy serwer, tym wyższą wartość możesz tu ustawić"

#: data/settings.php:79
msgid "10 (for weak shared hosting)"
msgstr "10 (dla słabego hostingu współdzielonego)"

#: data/settings.php:80
msgid "20"
msgstr "20"

#: data/settings.php:81
msgid "30 (optimal)"
msgstr "30 (optymalnie)"

#: data/settings.php:82
msgid "40"
msgstr "40"

#: data/settings.php:83
