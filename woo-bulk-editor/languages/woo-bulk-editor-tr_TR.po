msgstr "Özel sıralama düzeni."

#: data/fields.php:608
msgid "Reviews allowed"
msgstr "Değerlendirmelere izin verildi"

#: data/fields.php:625
msgid "Product url"
msgstr "Ürün URL'si"

#: data/fields.php:626
msgid "External/Affiliate product: External URL to the product"
msgstr "Harici/İştirak ürünü: Ürüne giden harici URL"

#: data/fields.php:640
