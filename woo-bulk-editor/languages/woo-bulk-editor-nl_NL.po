#: ext/mcp/access.php:147
msgid "Issue a new key? The old key stops working at once and the assistant using it is disconnected."
msgstr "Een nieuwe sleutel uitgeven? De oude sleutel stopt direct met werken en de assistent die deze gebruikt, wordt losgekoppeld."

#: ext/mcp/access.php:148
#: ext/mcp/bootstrap.php:563
msgid "Something went wrong. Reload the page and try again."
msgstr "Er is iets misgegaan. Herlaad de pagina en probeer het opnieuw."

