msgid "Author"
msgstr "投稿者"

#: data/fields.php:686
msgid "Attribute visibility"
msgstr "属性表示"

#: data/fields.php:699
msgid "Total sales"
msgstr "総売上数"

#: data/fields.php:700
msgid "Total count of the product sales"
msgstr "商品の総販売数"

#: data/fields.php:715
msgid "Review count"
msgstr "レビュー数"

#: data/fields.php:716
msgid "How many times the products been reviewed by customers"
msgstr "顧客によって商品がレビューされた回数"

#: data/fields.php:731
msgid "Average rating"
msgstr "平均評価"

#: data/fields.php:732
